data/*.sqlite
data/*.sqlite-*
data/upload-pending/
data/icon_map.json
logs/
*.log

# Extracted local Windows exe icons. Keep only the placeholder so the directory exists.
static/exe-icons/*
!static/exe-icons/.gitkeep

# OS/editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/

