# Winflow optional upload configuration.
# Copy this file to .env and fill in your own self-hosted endpoint.

# Required only when you run: python -m app.main upload-usage
WINFLOW_SERVER_URL=https://example.com
WINFLOW_UPLOAD_TOKEN=replace-with-a-long-random-token

# Optional stable device label shown by the receiving server.
WINFLOW_DEVICE_ID=my-windows-pc

# Optional custom database path.
# WINFLOW_DB=data/winflow.sqlite

# Optional custom runtime data directory.
# In source-tree development Winflow defaults to ./data.
# In installed runs Winflow defaults to the current Windows user's app data directory.
# WINFLOW_DATA_DIR=%LOCALAPPDATA%\Winflow

# Optional custom exe icon cache directory.
# WINFLOW_EXE_ICON_DIR=%LOCALAPPDATA%\Winflow\exe-icons
